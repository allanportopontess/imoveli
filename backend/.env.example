PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Opcional: sem esta chave, o chatbot fica indisponível mas o resto do app
# funciona normalmente. Pegue a sua em console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: se você criar uma chave no Google Cloud Console (Maps JavaScript API),
# coloque aqui para habilitar o mapa visual nos perfis. Sem ela, a distância
# real entre profissionais continua funcionando normalmente (só não desenha o mapa).
GOOGLE_MAPS_API_KEY=

# Opcional: sem nenhuma das duas chaves abaixo, o código de confirmação de
# email aparece no console do servidor (modo simulado) — o cadastro funciona
# normalmente para testes, só não chega no email de verdade.
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=
