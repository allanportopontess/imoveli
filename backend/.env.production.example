# IMOVELI — Variáveis de ambiente de produção
# Copie este arquivo para .env e preencha os valores reais

# === PostgreSQL (Railway fornece DATABASE_URL automaticamente) ===
DATABASE_URL=postgresql://user:password@host:5432/railway

# === JWT ===
JWT_SECRET=gere_um_segredo_forte_aqui_minimo_32_caracteres

# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === CORS — domínio do frontend Vercel (ex: https://imoveli.vercel.app) ===
CORS_ORIGINS=https://imoveli.vercel.app

# === E-mail (Resend) ===
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@imoveli.com.br

# === Ambiente ===
NODE_ENV=production
PORT=3000
